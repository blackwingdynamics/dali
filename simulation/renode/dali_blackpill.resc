:name: Dali_OS_STM32F4_Reference
:description: Dali OS STM32F4 development simulation using the Renode STM32F4 reference model.

using sysbus

$name?="Dali_OS_STM32F4_Reference"
$bin?=@target/thumbv7em-none-eabihf/debug/dali-kernel

mach create $name
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

cpu PerformanceInMips 100
sysbus LoadELF $bin

start
